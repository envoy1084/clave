{
  "name": "@tecpan/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Tecpan multisig account contract (Aztec.nr v6)",
  "type": "module",
  "scripts": {
    "build": "aztec compile",
    "codegen": "aztec codegen target -o artifacts",
    "test": "aztec test",
    "format": "aztec-nargo fmt --workspace",
