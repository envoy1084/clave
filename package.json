{
  "name": "clave",
  "private": true,
  "description": "Private k-of-n multisig on Aztec",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && turbo run lint typecheck build deny",
    "cli:install": "scripts/cli-install.sh",
    "codegen": "turbo run codegen",
    "demo": "scripts/demo.sh",
    "dev": "turbo run dev",
    "format": "oxfmt --write . && turbo run format",
    "format:check": "oxfmt --check . && turbo run format:check",
    "lint": "oxlint --deny-warnings . && turbo run lint",
    "lint:fix": "oxlint --fix .",
    "prepare": "lefthook install",
    "test": "turbo run test --concurrency=2",
    "test:e2e": "turbo run test:e2e",
    "test:cli": "scripts/cli-e2e.sh",
    "test:network": "crates/keeper/tests/network/run.sh",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "klarity": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0"
}
