{
  "extends": "klarity/tsconfig/app/node",
  "compilerOptions": {
    "types": ["node"],
    "exactOptionalPropertyTypes": false,
    "paths": {
      "@shared/*": ["./src/shared/*"]
    },
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/engine/**/*.ts",
    "src/shared/**/*.ts",
    "*.config.ts"
  ]
}
