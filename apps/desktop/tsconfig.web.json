{
  "extends": "klarity/tsconfig/app/vite",
  "compilerOptions": {
    "exactOptionalPropertyTypes": false,
    "paths": { "@/*": ["./src/renderer/src/*"], "@shared/*": ["./src/shared/*"] }
  },
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "src/shared/**/*.ts",
    "src/preload/api.d.ts"
  ]
}
