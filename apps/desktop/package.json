    "@aztec-labs/stdlib": "catalog:",
    "@tecpan/napi": "workspace:*",
    "@tecpan/vault-wallet": "workspace:*",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
