{
  "name": "@tecpan/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Tecpan desktop app (Electron + React)",
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "lint": "oxlint --deny-warnings .",
