{
  "name": "@clave/napi",
  "version": "0.0.0",
  "private": true,
  "description": "Node-API bindings of Clave crypto and wire",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "napi build --platform --release --esm --output-dir dist && napi build --platform --release --esm --features testing --output-dir dist/testing",
    "lint": "oxlint --deny-warnings test",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@aztec-labs/foundation": "catalog:",
    "@aztec-labs/stdlib": "catalog:",
    "@napi-rs/cli": "catalog:",
    "@types/node": "catalog:",
    "klarity": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "napi": {
    "binaryName": "clave"
  }
}
